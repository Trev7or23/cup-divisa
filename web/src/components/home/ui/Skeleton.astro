<div class="flex flex-col items-center px-4 py-10 md:px-6 md:py-14 lg:px-10">
  <div class="relative flex w-full max-w-[540px] flex-col items-center">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -left-16 -top-20 h-64 w-64 rounded-full bg-primary-container/10 blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-secondary-container/15 blur-3xl"
    >
    </div>

    <div class="relative z-10 flex w-full flex-col items-center">
      <!-- Pill de sincronización -->
      <div
        class="mb-2 flex w-full items-center justify-center gap-1.5"
        aria-hidden="true"
      >
        <div class="h-3.5 w-3.5 animate-pulse rounded-full bg-surface-container-high"></div>
        <div class="h-3 w-40 animate-pulse rounded-full bg-surface-container-high"></div>
      </div>

      <!-- Tarjeta principal -->
      <article
        role="status"
        aria-label="Cargando tarjeta de monitoreo"
        class="relative w-full overflow-hidden rounded-xl bg-surface-container p-4 shadow-2xl backdrop-blur-md sm:p-6"
      >
        <span class="sr-only">Cargando…</span>
        <div
          class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-primary-container/70 to-transparent"
        >
        </div>

        <header class="mb-4 w-full">
          <div class="mb-1 flex items-center justify-between gap-2">
            <div class="h-3 w-28 animate-pulse rounded-full bg-surface-container-high"></div>
            <div class="h-4 w-24 animate-pulse rounded-full bg-surface-container-high"></div>
          </div>
          <div class="grid grid-cols-4 gap-1 rounded-base bg-surface-container-lowest p-1">
            {Array.from({ length: 8 }).map(() => (
              <div class="h-9 animate-pulse rounded-base bg-surface-container-high/70"></div>
            ))}
          </div>
        </header>

        <section class="flex w-full flex-col items-center rounded-lg bg-surface-container-low p-4 text-center sm:p-6">
          <div class="mb-2 h-3 w-40 animate-pulse rounded-full bg-surface-container-high"></div>
          <div class="my-2 h-10 w-36 animate-pulse rounded-md bg-surface-container-high sm:h-12"></div>
          <div class="mt-3 h-6 w-48 animate-pulse rounded-full bg-surface-container-high"></div>
        </section>
      </article>
    </div>
  </div>
</div>
