---
import { Font } from 'astro:assets'
import '@/global.css'
import Header from '@/components/shared/ui/Header.astro'
import Footer from '@/components/shared/ui/Footer.astro'
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Monitor y conversor de tasas de cambio del peso cubano (CUP) en tiempo real."
    />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-hanken-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <title>CUP Tracker · Tasas en tiempo real</title>
  </head>
  <body class="min-h-dvh bg-background font-body text-on-surface antialiased">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
    >
      <div class="absolute -left-40 -top-40 h-[36rem] w-[36rem] rounded-full bg-primary-container/5 blur-[140px]"></div>
      <div class="absolute -bottom-48 -right-40 h-[40rem] w-[40rem] rounded-full bg-secondary-container/10 blur-[160px]"></div>
      <div class="absolute left-1/2 top-1/3 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-indigo-500/5 blur-[160px]"></div>
    </div>

    <div class="relative z-10 flex min-h-dvh flex-col">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
