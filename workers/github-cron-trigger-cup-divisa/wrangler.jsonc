{
	"name": "github-cron-trigger-cup-divisa",
	"main": "src/worker.js",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-11-24",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
	"triggers": {
		"crons": [
			"*/30 * * * *"
		],
	},
	"secrets": {
		"required": [
			"GITHUB_TOKEN"
		],
	},
	"vars": {},
}
