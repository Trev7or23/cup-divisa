{
  "name": "backend",
  "version": "1.0.0",
  "description": "A Server to host the cup currency actual value",
  "main": "./src/server.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm run swagger && tsc",
    "start": "node dist/server.js",
    "dev": "pnpm run swagger && tsx watch src/server.ts",
    "swagger": "tsx ./src/swagger.ts",
    "migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts"
  },
  "keywords": [],
  "author": "Trev7or23",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/sqlite3": "^5.1.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "swagger-autogen": "^2.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
